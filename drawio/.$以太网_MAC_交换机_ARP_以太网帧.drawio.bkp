  <diagram name="4-交换机MAC学习与转发" id="switch_learning">
    <mxGraphModel dx="2586" dy="1606" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=28;fontStyle=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;" value="交换机如何转发：学习源 MAC，查找目的 MAC" vertex="1">
          <mxGeometry height="45" width="1040" x="430" y="55" as="geometry" />
        </mxCell>
        <mxCell id="sub" parent="1" style="text;html=1;fontSize=18;fontStyle=1;strokeColor=none;fillColor=none;fontColor=#333333;fontFamily=Comic Sans MS;" value="交换机不是靠 IP 转发普通二层帧，而是靠 MAC 地址表；它会从每个收到的帧里学习“源 MAC 在哪个端口”" vertex="1">
          <mxGeometry height="40" width="1460" x="220" y="110" as="geometry" />
        </mxCell>
        <mxCell id="sw" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=4;fontFamily=Comic Sans MS;" value="交换机  MAC 地址表 AA:AA... → 端口 1 BB:BB... → 端口 2 CC:CC... → 端口 3" vertex="1">
          <mxGeometry height="240" width="380" x="760" y="340" as="geometry" />
        </mxCell>
        <mxCell id="A" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=4;shadow=1;sketch=1;jiggle=1;fontFamily=Comic Sans MS;" value="端口 1 主机 A MAC：AA:AA..." vertex="1">
          <mxGeometry height="130" width="300" x="90" y="280" as="geometry" />
        </mxCell>
        <mxCell id="B" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=4;shadow=1;sketch=1;jiggle=1;fontFamily=Comic Sans MS;" value="端口 2 主机 B MAC：BB:BB..." vertex="1">
          <mxGeometry height="130" width="300" x="1510" y="280" as="geometry" />
        </mxCell>
        <mxCell id="C" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=4;shadow=1;sketch=1;jiggle=1;fontFamily=Comic Sans MS;" value="端口 3 主机 C MAC：CC:CC..." vertex="1">
          <mxGeometry height="130" width="300" x="90" y="700" as="geometry" />
        </mxCell>
        <mxCell id="D" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=4;shadow=1;sketch=1;jiggle=1;fontFamily=Comic Sans MS;" value="端口 4 主机 D MAC：DD:DD..." vertex="1">
          <mxGeometry height="130" width="300" x="1510" y="700" as="geometry" />
        </mxCell>
        <mxCell id="learn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;fontFamily=Comic Sans MS;" value="交换机学习过程  1. 从端口 1 收到帧 2. 看到源 MAC = AA:AA... 3. 记录：AA:AA... 在端口 1  这叫 MAC 学习。" vertex="1">
          <mxGeometry height="230" width="420" x="460" y="850" as="geometry" />
        </mxCell>
        <mxCell id="forward" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;fontFamily=Comic Sans MS;" value="交换机转发过程  如果目的 MAC = BB:BB... 并且表里知道 BB 在端口 2： 只从端口 2 发出去。  如果不知道目的 MAC： 会向其他端口泛洪。" vertex="1">
          <mxGeometry height="230" width="420" x="1020" y="850" as="geometry" />
        </mxCell>
        <mxCell id="unicast" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=4;fontFamily=Comic Sans MS;" value="单播  目的 MAC 是某一台设备的 MAC。 交换机查表后，只发到对应端口。" vertex="1">
          <mxGeometry height="120" width="320" x="480" y="200" as="geometry" />
        </mxCell>
        <mxCell id="broadcast" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=4;fontFamily=Comic Sans MS;" value="广播  目的 MAC = FF:FF:FF:FF:FF:FF。 交换机会发到同一广播域内的其他端口。 ARP 请求就是典型广播。" vertex="1">
          <mxGeometry height="120" width="360" x="1120" y="200" as="geometry" />
        </mxCell>
        <mxCell id="debug" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=24;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=3;fontFamily=Comic Sans MS;" value="工程调试提示  同一个交换机下无法通信：看链路、VLAN、ARP、MAC 表。  广播包很多：可能有 ARP 风暴、环路、异常设备。  MAC 表频繁变化：可能有环路、设备移动、MAC 冲突或网络异常。" vertex="1">
          <mxGeometry height="180" width="960" x="470" y="1160" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="A" style="endArrow=block;html=1;rounded=0;strokeWidth=4;fontStyle=1;fontSize=24;endSize=10;fontFamily=Comic Sans MS;" target="sw" value="源MAC=AA，目的MAC=BB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="sw" style="endArrow=block;html=1;rounded=0;strokeWidth=4;fontStyle=1;fontSize=24;endSize=10;fontFamily=Comic Sans MS;" target="B" value="查表后转发到端口2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="C" style="endArrow=block;html=1;rounded=0;strokeWidth=3;dashed=1;strokeColor=#000000;endSize=8;fontFamily=Comic Sans MS;fontSize=24;" target="sw" value="其他端口可参与学习">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="sw" style="endArrow=block;html=1;rounded=0;strokeWidth=3;dashed=1;strokeColor=#000000;endSize=8;fontFamily=Comic Sans MS;fontSize=24;" target="D" value="未知目的时可能泛洪">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="learn" style="endArrow=block;html=1;rounded=0;strokeWidth=3;dashed=1;strokeColor=#000000;endSize=8;fontFamily=Comic Sans MS;fontSize=24;" target="sw" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="sw" style="endArrow=block;html=1;rounded=0;strokeWidth=3;dashed=1;strokeColor=#000000;endSize=8;fontFamily=Comic Sans MS;fontSize=24;" target="forward" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
