        <mxCell id="row_trans_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Comic Sans MS;strokeWidth=4;" value="TCP 段 / UDP 数据报" vertex="1">
