        <mxCell id="row_net_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Comic Sans MS;strokeWidth=4;" value="IP、子网掩码、网关、路由、ping、traceroute" vertex="1">
