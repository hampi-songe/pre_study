        </mxCell>
        <mxCell id="row_link_0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Comic Sans MS;strokeWidth=4;" value="链路层" vertex="1">
          <mxGeometry height="110" width="180" x="90" y="710" as="geometry" />
        </mxCell>
        <mxCell id="row_link_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Comic Sans MS;strokeWidth=4;" value="在当前局域网里，下一跳是哪块网卡？" vertex="1">
          <mxGeometry height="110" width="360" x="290" y="710" as="geometry" />
        </mxCell>
        <mxCell id="row_link_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Comic Sans MS;strokeWidth=4;" value="以太网帧" vertex="1">
          <mxGeometry height="110" width="260" x="670" y="710" as="geometry" />
        </mxCell>
        <mxCell id="row_link_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Comic Sans MS;strokeWidth=4;" value="MAC 地址 例如：00:11:22:33:44:55" vertex="1">
          <mxGeometry height="110" width="300" x="950" y="710" as="geometry" />
        </mxCell>
        <mxCell id="row_link_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Comic Sans MS;strokeWidth=4;" value="ARP、交换机端口、VLAN、帧错误、FCS/CRC" vertex="1">
          <mxGeometry height="110" width="480" x="1270" y="710" as="geometry" />
        </mxCell>
        <mxCell id="row_phy_0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;strokeWidth=4;" value="物理层" vertex="1">
          <mxGeometry height="110" width="180" x="90" y="850" as="geometry" />
        </mxCell>
        <mxCell id="row_phy_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;strokeWidth=4;" value="0 和 1 如何变成真实信号并传过去？" vertex="1">
          <mxGeometry height="110" width="360" x="290" y="850" as="geometry" />
        </mxCell>
        <mxCell id="row_phy_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;strokeWidth=4;" value="bit / 电信号 / 光信号 / 无线信号" vertex="1">
          <mxGeometry height="110" width="260" x="670" y="850" as="geometry" />
        </mxCell>
        <mxCell id="row_phy_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;strokeWidth=4;" value="物理端口、线缆、信道、频点" vertex="1">
          <mxGeometry height="110" width="300" x="950" y="850" as="geometry" />
        </mxCell>
        <mxCell id="row_phy_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;strokeWidth=4;" value="网口灯、Link Up、速率协商、线缆质量、误码率" vertex="1">
          <mxGeometry height="110" width="480" x="1270" y="850" as="geometry" />
        </mxCell>
        <mxCell id="extra1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Comic Sans MS;strokeWidth=2;" value="几个容易混的词  主机：能联网收发数据的设备，不一定是电脑，也可以是通信板卡、模块、服务器。  协议：通信双方共同遵守的规则，规定字段含义、顺序、长度、校验、响应方式。  头部：每层加在前面的控制信息，例如 IP 头、TCP 头、以太网头。  有效载荷 Payload：真正要交给上层的内容，例如 START。" vertex="1">
          <mxGeometry height="260" width="520" x="130" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="extra2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Comic Sans MS;strokeWidth=2;" value="一个完整发送目标如何理解？  192.168.1.20 : 5000  IP 地址 192.168.1.20：找到哪台主机。 端口 5000：找到这台主机上的哪个程序。 MAC 地址：底层在局域网内真正发帧时还需要。  所以：IP 找主机，端口找程序，MAC 找局域网下一跳网卡。" vertex="1">
          <mxGeometry height="260" width="520" x="690" y="1040" as="geometry" />
        </mxCell>
        <mxCell id="extra3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=17;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Comic Sans MS;strokeWidth=2;" value="抓包时的一个重要视角  你看到的不是单纯的 START，而是被层层包裹后的数据。  如果 Wireshark 能看到以太网帧，说明至少链路层数据到了。 如果能看到 ICMP echo reply，说明网络层基本通。 如果能看到 TCP 三次握手成功，说明传输层连接建立。 如果 TCP 有数据但业务没响应，多半要看应用协议。" vertex="1">
          <mxGeometry height="260" width="520" x="1250" y="1040" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3-分层排障流程" id="diagram_troubleshoot">
    <mxGraphModel dx="1645" dy="1022" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title3" parent="1" style="text;html=1;fontSize=26;fontStyle=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;" value="分层排障流程图：设备通信失败时，如何一步步定位？" vertex="1">
          <mxGeometry height="40" width="1000" x="630" y="130" as="geometry" />
        </mxCell>
        <mxCell id="sub3" parent="1" style="text;html=1;fontSize=18;fontStyle=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;fontColor=#333333;" value="原则：先确认下层是否正常，再看上层。下层不通，上层一定不可靠。" vertex="1">
          <mxGeometry height="35" width="940" x="660" y="180" as="geometry" />
        </mxCell>
        <mxCell id="f1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;strokeWidth=4;" value="1. 物理层 网口灯亮吗？Link Up 吗？ 线缆、供电、PHY、自协商、速率双工正常吗？  不正常：先别看 IP/TCP，先修物理链路。" vertex="1">
          <mxGeometry height="220" width="290" x="120" y="260" as="geometry" />
        </mxCell>
        <mxCell id="f2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Comic Sans MS;strokeWidth=4;" value="2. 链路层 ARP 正常吗？MAC 地址对吗？ 交换机端口、VLAN、帧错误、FCS/CRC 是否异常？  不正常：本地局域网转发可能有问题。" vertex="1">
          <mxGeometry height="220" width="290" x="460" y="260" as="geometry" />
        </mxCell>
        <mxCell id="f3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Comic Sans MS;strokeWidth=4;" value="3. 网络层 IP 地址、子网掩码、网关、路由配置对吗？ 能 ping 通目标吗？是否跨网段？  不正常：检查 IP 配置、路由、网关、防火墙。" vertex="1">
          <mxGeometry height="220" width="290" x="800" y="260" as="geometry" />
        </mxCell>
        <mxCell id="f4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Comic Sans MS;strokeWidth=4;" value="4. 传输层 TCP 端口能连接吗？服务是否监听？ UDP 包是否到达？是否重传/超时？  不正常：检查端口、socket、连接队列、防火墙。" vertex="1">
          <mxGeometry height="220" width="290" x="1140" y="260" as="geometry" />
        </mxCell>
        <mxCell id="f5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Comic Sans MS;strokeWidth=4;" value="5. 应用层 协议格式正确吗？长度字段、校验、大小端对吗？ 设备当前状态允许这个命令吗？  不正常：看协议解析、业务日志、状态机。" vertex="1">
          <mxGeometry height="220" width="290" x="1480" y="260" as="geometry" />
        </mxCell>
        <mxCell id="flow_a1" edge="1" parent="1" source="f1" style="endArrow=block;html=1;rounded=0;strokeWidth=4;fontStyle=1;fontFamily=Comic Sans MS;fontSize=20;endSize=10;" target="f2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow_a2" edge="1" parent="1" source="f2" style="endArrow=block;html=1;rounded=0;strokeWidth=4;fontStyle=1;fontFamily=Comic Sans MS;fontSize=20;endSize=10;" target="f3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow_a3" edge="1" parent="1" source="f3" style="endArrow=block;html=1;rounded=0;strokeWidth=4;fontStyle=1;fontFamily=Comic Sans MS;fontSize=20;endSize=10;" target="f4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow_a4" edge="1" parent="1" source="f4" style="endArrow=block;html=1;rounded=0;strokeWidth=4;fontStyle=1;fontFamily=Comic Sans MS;fontSize=20;endSize=10;" target="f5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="case_title" parent="1" style="text;html=1;fontSize=26;fontStyle=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;" value="典型现象 → 可能层级" vertex="1">
          <mxGeometry height="35" width="320" x="790" y="560" as="geometry" />
        </mxCell>
        <mxCell id="c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;strokeWidth=4;" value="网口灯不亮 / Link Down → 优先怀疑物理层：线缆、接口、PHY、自协商" vertex="1">
          <mxGeometry height="80" width="1060" x="420" y="640" as="geometry" />
        </mxCell>
        <mxCell id="c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Comic Sans MS;strokeWidth=4;" value="网口灯亮，但 ARP 不到 → 优先怀疑链路层：MAC、交换机、VLAN、ARP" vertex="1">
          <mxGeometry height="80" width="1060" x="420" y="750" as="geometry" />
        </mxCell>
        <mxCell id="c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Comic Sans MS;strokeWidth=4;" value="ARP 有了，但 ping 不通 → 优先怀疑网络层：IP、掩码、网关、路由、防火墙" vertex="1">
          <mxGeometry height="80" width="1060" x="420" y="860" as="geometry" />
        </mxCell>
        <mxCell id="c4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Comic Sans MS;strokeWidth=4;" value="ping 通，但 TCP 端口连不上 → 优先怀疑传输层：端口未监听、服务未启动、连接被拦截" vertex="1">
          <mxGeometry height="80" width="1060" x="420" y="970" as="geometry" />
        </mxCell>
        <mxCell id="c5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Comic Sans MS;strokeWidth=4;" value="TCP 连上，但命令没响应 → 优先怀疑应用层：协议格式、长度、校验、状态机" vertex="1">
          <mxGeometry height="80" width="1060" x="420" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="summary3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Comic Sans MS;strokeWidth=3;" value="最实用的一句话：不要笼统说“网络坏了”，而要判断“坏在第几层”。 分层思想的工程价值，就是把大问题拆成可以验证的小问题。" vertex="1">
          <mxGeometry height="100" width="1060" x="420" y="1220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
