        <mxCell id="h4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=19;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Comic Sans MS;strokeWidth=3;" value="工程上重点看什么" vertex="1">
          <mxGeometry height="70" width="480" x="1270" y="190" as="geometry" />
        </mxCell>
        <mxCell id="row_app_0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Comic Sans MS;strokeWidth=4;" value="应用层" vertex="1">
          <mxGeometry height="110" width="180" x="90" y="290" as="geometry" />
        </mxCell>
        <mxCell id="row_app_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Comic Sans MS;strokeWidth=4;" value="我要表达什么业务含义？ 数据字段怎么排列？ 对方收到后怎么解释？" vertex="1">
          <mxGeometry height="110" width="360" x="290" y="290" as="geometry" />
