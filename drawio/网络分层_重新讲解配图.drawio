        <mxCell id="row_net_0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Comic Sans MS;strokeWidth=4;" value="网络层" vertex="1">
          <mxGeometry height="110" width="180" x="90" y="570" as="geometry" />
        </mxCell>
        <mxCell id="row_net_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Comic Sans MS;strokeWidth=4;" value="目标主机在哪里？ 下一跳往哪里走？" vertex="1">
          <mxGeometry height="110" width="360" x="290" y="570" as="geometry" />
        </mxCell>
        <mxCell id="row_net_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Comic Sans MS;strokeWidth=4;" value="IP 包 / IP 数据报" vertex="1">
          <mxGeometry height="110" width="260" x="670" y="570" as="geometry" />
        </mxCell>
        <mxCell id="row_net_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Comic Sans MS;strokeWidth=4;" value="IP 地址 例如：192.168.1.20" vertex="1">
          <mxGeometry height="110" width="300" x="950" y="570" as="geometry" />
