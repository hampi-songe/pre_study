<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.3.6 Chrome/140.0.7339.249 Electron/38.8.0 Safari/537.36" version="29.3.6" pages="3">
  <diagram name="1-网络分层总览" id="diagram_overview">
    <mxGraphModel dx="1810" dy="2324" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;fontSize=26;fontStyle=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;" value="网络分层：发送端封装 → 网络传输 → 接收端解封装" vertex="1">
          <mxGeometry height="40" width="860" x="660" y="80" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="text;html=1;fontSize=18;fontStyle=1;strokeColor=none;fillColor=none;fontFamily=Comic Sans MS;fontColor=#333333;" value="先理解基本词：主机=能联网的设备；协议=通信规则；头部=每层加的控制信息；载荷=真正要传的业务数据" vertex="1">
          <mxGeometry height="35" width="1300" x="500" y="120" as="geometry" />
        </mxCell>
        <mxCell id="sender_panel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=25;fontStyle=1;fillColor=#E8E8E8;strokeColor=none;fontFamily=Comic Sans MS;fontColor=#333333;verticalAlign=top;arcSize=6;shadow=1;sketch=1;curveFitting=1;jiggle=2;" value="发送端设备 A 例如：上位机 / 嵌入式板卡 / 通信设备" vertex="1">
          <mxGeometry height="840" width="370" x="80" y="170" as="geometry" />
        </mxCell>
        <mxCell id="receiver_panel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=25;fontStyle=1;fillColor=#E8E8E8;strokeColor=none;fontFamily=Comic Sans MS;fontColor=#333333;verticalAlign=top;arcSize=6;shadow=1;sketch=1;curveFitting=1;jiggle=2;" value="接收端设备 B 例如：服务器 / 模块 / 另一台设备" vertex="1">
          <mxGeometry height="840" width="370" x="1450" y="170" as="geometry" />
        </mxCell>
        <mxCell id="s_app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Comic Sans MS;strokeWidth=4;" value="应用层&amp;nbsp;&lt;div&gt;业务数据：START&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp;基本概念：&amp;nbsp;&lt;/div&gt;&lt;div&gt;应用=真正使用网络的程序&amp;nbsp;&lt;/div&gt;&lt;div&gt;协议=双方约定的数据格式&amp;nbsp;&lt;/div&gt;&lt;div&gt;载荷=真正想传的内容&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="310" x="110" y="250" as="geometry" />
        </mxCell>
        <mxCell id="s_trans" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Comic Sans MS;strokeWidth=4;" value="传输层 加 TCP/UDP 头 端口：5000  基本概念：&amp;nbsp;&lt;div&gt;端口=主机里某个程序的编号&amp;nbsp;&lt;/div&gt;&lt;div&gt;TCP=可靠连接&amp;nbsp;&lt;/div&gt;&lt;div&gt;UDP=简单快速&lt;/div&gt;" vertex="1">
          <mxGeometry height="135" width="310" x="110" y="420" as="geometry" />
        </mxCell>
        <mxCell id="s_net" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Comic Sans MS;strokeWidth=4;" value="网络层 加 IP 头&amp;nbsp;&lt;div&gt;目的 IP：192.168.1.20&amp;nbsp;&lt;div&gt;&amp;nbsp;基本概念：&amp;nbsp;&lt;/div&gt;&lt;div&gt;IP=主机的网络地址&amp;nbsp;&lt;/div&gt;&lt;div&gt;路由=决定下一步往哪走&amp;nbsp;&lt;/div&gt;&lt;div&gt;网关=出本网段的门&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="310" x="110" y="590" as="geometry" />
        </mxCell>
        <mxCell id="s_link" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Comic Sans MS;strokeWidth=4;" value="链路层 加以太网头 / FCS&amp;nbsp;&lt;div&gt;目的 MAC：xx:xx:xx&amp;nbsp;&lt;/div&gt;&lt;div&gt;&amp;nbsp;基本概念：&amp;nbsp;&lt;/div&gt;&lt;div&gt;MAC=网卡地址&amp;nbsp;&lt;/div&gt;&lt;div&gt;帧=链路层数据块&amp;nbsp;&lt;/div&gt;&lt;div&gt;ARP=由 IP 找 MAC&lt;/div&gt;" vertex="1">
          <mxGeometry height="145" width="310" x="110" y="770" as="geometry" />
        </mxCell>
        <mxCell id="gcfXY027YenBBpGP9JoF-3" edge="1" parent="1" source="s_phy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeWidth=6;endArrow=classicThin;endFill=0;endSize=6;curved=0;" target="netdev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s_phy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;strokeWidth=4;" value="物理层 bit → 电信号 / 光信号&amp;nbsp;&lt;div&gt;&amp;nbsp;基本概念： bit=0或1&amp;nbsp;&lt;/div&gt;&lt;div&gt;介质=网线/光纤/无线信道&amp;nbsp;&lt;/div&gt;&lt;div&gt;Link=物理连接建立&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="310" x="110" y="950" as="geometry" />
        </mxCell>
        <mxCell id="r_app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Comic Sans MS;strokeWidth=4;" value="应用层 得到业务数据：START  做什么： 解释业务命令 检查字段、长度、校验 进入设备业务状态机" vertex="1">
          <mxGeometry height="135" width="310" x="1480" y="250" as="geometry" />
        </mxCell>
        <mxCell id="r_trans" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Comic Sans MS;strokeWidth=4;" value="传输层 检查端口 / TCP 状态 去掉 TCP/UDP 头  做什么： 确认交给哪个程序 TCP 还会处理确认、重传、排序" vertex="1">
          <mxGeometry height="135" width="310" x="1480" y="420" as="geometry" />
        </mxCell>
        <mxCell id="r_net" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Comic Sans MS;strokeWidth=4;" value="网络层 检查目的 IP 去掉 IP 头  做什么： 确认是否发给本机 需要转发时查路由表" vertex="1">
          <mxGeometry height="145" width="310" x="1480" y="590" as="geometry" />
        </mxCell>
        <mxCell id="r_link" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Comic Sans MS;strokeWidth=4;" value="链路层 检查以太网帧 / FCS 去掉以太网头  做什么： 确认 MAC 是否匹配 检查帧是否完整、有无错误" vertex="1">
          <mxGeometry height="145" width="310" x="1480" y="770" as="geometry" />
        </mxCell>
        <mxCell id="r_phy" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Comic Sans MS;strokeWidth=4;" value="物理层 电信号 / 光信号 → bit  做什么： 从真实信号恢复比特流 关注线缆、速率、自协商、误码" vertex="1">
          <mxGeometry height="130" width="310" x="1480" y="950" as="geometry" />
        </mxCell>
        <mxCell id="pkt_app" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Comic Sans MS;strokeWidth=4;" value="应用层数据 START" vertex="1">
          <mxGeometry height="55" width="320" x="780" y="290" as="geometry" />
        </mxCell>
        <mxCell id="pkt_tcp" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Comic Sans MS;strokeWidth=4;" value="传输层封装 [TCP头][START]" vertex="1">
          <mxGeometry height="55" width="400" x="740" y="460" as="geometry" />
        </mxCell>
        <mxCell id="pkt_eth" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Comic Sans MS;strokeWidth=4;" value="链路层封装 [以太网头][IP头][TCP头][START][FCS]" vertex="1">
          <mxGeometry height="60" width="600" x="640" y="800" as="geometry" />
        </mxCell>
        <mxCell id="gcfXY027YenBBpGP9JoF-1" edge="1" parent="1" source="netdev" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=default;strokeWidth=6;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=default;labelBackgroundColor=default;endArrow=classic;curved=0;" target="r_phy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="netdev" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=18;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Comic Sans MS;strokeWidth=4;" value="网络 / 交换机 / 路由器  交换机：主要看 MAC，转发“帧” 路由器：主要看 IP，转发“包” 通常不理解应用层 START 的业务含义" vertex="1">
          <mxGeometry height="130" width="440" x="720" y="1125" as="geometry" />
        </mxCell>
        <mxCell id="why_layer" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=25;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Comic Sans MS;strokeWidth=2;" value="为什么要分层？  复杂通信被拆成多个小问题。 应用程序不用关心电压怎么变化；网卡也不用理解业务命令 START。  价值：降低复杂度、便于替换模块、便于团队协作、便于按层排障。" vertex="1">
          <mxGeometry height="190" width="380" x="80" y="-170" as="geometry" />
        </mxCell>
        <mxCell id="peer_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=25;fontStyle=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Comic Sans MS;strokeWidth=2;" value="虚线表示“逻辑上的同层通信”  看起来像：应用层 ↔ 应用层，TCP ↔ TCP，IP ↔ IP。  但真实数据路径仍然是：向下封装 → 通过网络 → 向上解封装。" vertex="1">
          <mxGeometry height="190" width="380" x="480" y="-170" as="geometry" />
        </mxCell>
